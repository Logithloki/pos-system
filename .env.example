# Initial admin seed (required only for first run)
POS_ADMIN_USERNAME=admin
POS_ADMIN_PASSWORD=ChangeThisNow_123!

# Required API JWT signing key (at least 32 random characters)
Security__JwtSigningKey=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Optional store metadata
POS_STORE_NAME=My Retail Store

# Optional DB path override for design-time tooling
POS_DB_PATH=

# Optional desktop data path overrides (used by POS.Desktop.exe)
POS_DESKTOP_DB_PATH=
POS_DESKTOP_BACKUP_DIR=
POS_DESKTOP_SPOOL_DIR=

# Optional desktop behavior tuning
POS_TAX_RATE_PERCENT=5
POS_BACKUP_RETENTION_DAYS=30
POS_BACKUP_INTERVAL_MINUTES=240
POS_RECEIPT_MAX_RETRY_ATTEMPTS=3
POS_RECEIPT_RETRY_DELAY_MS=120
